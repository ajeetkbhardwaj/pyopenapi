  "components": {
    "schemas": {
      "SupplierSerializer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "name": {
            "type": "string",
            "maxLength": 150
          },
          "profile": {
            "type": "integer"
          }
        },
        "required": [
          "name",
          "profile"
        ]
      },
      "ReviewSerializer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "content": {
            "type": "string"
          },
          "rating": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "required": [
          "content",
          "rating"
        ]
      },
      "CategorySerializer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "name": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ]
      },
      "ManufacturerSerializer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "country": {
            "type": "string",
            "maxLength": 50
          }
        },
        "required": [
          "name",
          "country"
        ]
      },
      "AdvancedProductSerializer": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "maxLength": 50
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "manufacturer": {
            "type": "integer"
          },
          "supplier_details": {
            "type": "string",
            "readOnly": true
          },
          "location_count": {
            "type": "object",
            "readOnly": true
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "required": [
          "sku",
          "name",
          "locations"
        ]
      },
      "ProductSerializer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "name": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ]
      },
      "Supplier": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 150
          },
          "profile": {
            "type": "integer"
