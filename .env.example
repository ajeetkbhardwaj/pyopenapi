# ---- pyopenapi server settings ----
# Transport: stdio | sse | streamable-http
PYOPENAPI_TRANSPORT=stdio
PYOPENAPI_HOST=127.0.0.1
PYOPENAPI_PORT=8765

# Where analysis artifacts are cached (defaults to ~/.cache/pyopenapi)
# PYOPENAPI_CACHE_DIR=/absolute/path/to/cache

# Logging: DEBUG | INFO | WARNING | ERROR (always written to stderr)
PYOPENAPI_LOG_LEVEL=INFO

# Django: try runtime URLconf extraction before falling back to static AST.
# Keep false in sandboxes/CI where the analysed project's dependencies are absent.
PYOPENAPI_DEFAULT_USE_DYNAMIC=false

# Root of the knowl-apidocs repository (auto-detected when running from source)
# PYOPENAPI_KNOWL_ROOT=/absolute/path/to/knowl-apidocs

# Optional HTTP transport auth (send as `Authorization: Bearer <key>`)
# PYOPENAPI_API_KEY=change-me

# ---- HTTP transport hardening / observability ----
# Health endpoints: GET /health, /healthz, /ready, /readyz
PYOPENAPI_ENABLE_HEALTH_ENDPOINTS=true
# Prometheus metrics: GET /metrics (JSON at /metrics.json)
PYOPENAPI_ENABLE_METRICS_ENDPOINT=true
PYOPENAPI_METRICS_PATH=/metrics
# Reject request bodies larger than this many bytes (0 disables)
PYOPENAPI_MAX_REQUEST_BYTES=10000000
# Per-request timeout in seconds (0 disables)
PYOPENAPI_REQUEST_TIMEOUT_SECONDS=1800
# Rate limiting: requests/minute per client IP; 0 disables. Burst adds headroom.
PYOPENAPI_RATE_LIMIT_PER_MINUTE=0
PYOPENAPI_RATE_LIMIT_BURST=20
# Only trust X-Forwarded-For from these proxy IPs (JSON list or comma-separated)
# PYOPENAPI_TRUSTED_PROXIES=["10.0.0.1"]
# JSON logs (one object per line) instead of the default text format
PYOPENAPI_LOG_JSON=false

# ---- Analysis / cache limits ----
PYOPENAPI_MAX_SCAN_FILES=20000
PYOPENAPI_MAX_FILE_BYTES=2000000
PYOPENAPI_LOCK_TIMEOUT_SECONDS=900
# Prune cached analyses older than this (days) and/or above this size (bytes; 0 disables)
PYOPENAPI_CACHE_MAX_AGE_DAYS=30
PYOPENAPI_CACHE_MAX_BYTES=5000000000

# Output OpenAPI version: 3.0.3 (default) or 3.1.0
PYOPENAPI_OPENAPI_VERSION=3.0.3

# ---- Git / private repositories ----
# HTTPS token for private GitHub repositories (also reads GITHUB_TOKEN/GH_TOKEN)
# PYOPENAPI_GITHUB_TOKEN=ghp_...
# Path to a private key for SSH clones (git@github.com:owner/repo.git)
# PYOPENAPI_GITHUB_SSH_KEY=/absolute/path/to/id_ed25519

# ---- OpenAI-compatible LLM enrichment ----
# Provider: auto | nvidia | openrouter | lmstudio | llamacpp | ollama | openai-compatible
# "auto" prefers NVIDIA (key present), then OpenRouter (key present), then Ollama (OLLAMA_HOST set), else static.
# PYOPENAPI_LLM_PROVIDER=auto
# PYOPENAPI_LLM_BASE_URL=http://127.0.0.1:11434/v1
# PYOPENAPI_LLM_API_KEY=
# PYOPENAPI_LLM_SPEC_MODEL=
# PYOPENAPI_LLM_CONTEXT_MODEL=
# PYOPENAPI_LLM_TIMEOUT_SECONDS=120
# PYOPENAPI_LLM_MAX_CONCURRENCY=4
# PYOPENAPI_LLM_ENDPOINTS_PER_REQUEST=40
# Stop enrichment after this many total tokens (0 disables the budget)
# PYOPENAPI_LLM_MAX_TOKENS_BUDGET=0

# NVIDIA NIM (defaults shown; used by engine="nvidia"/"auto")
# Set NVIDIA_API_KEY in your shell or a local .env file (never commit real keys).
#NVIDIA_API_KEY=your-nvidia-api-key
#PYOPENAPI_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
PYOPENAPI_NVIDIA_SPEC_MODEL=nvidia/nemotron-3-ultra-550b-a55b
PYOPENAPI_NVIDIA_CONTEXT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# OpenRouter (defaults shown; used by engine="openrouter"/"auto")
# Set OPENROUTER_API_KEY in your shell or a local .env file (never commit real keys).
#OPENROUTER_API_KEY=your-openrouter-api-key
#OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
#PYOPENAPI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#PYOPENAPI_OPENROUTER_SPEC_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
#PYOPENAPI_OPENROUTER_CONTEXT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Lower reasoning effort keeps JSON output within token limits for reasoning models.
#PYOPENAPI_OPENROUTER_REASONING_EFFORT=low
#PYOPENAPI_OPENROUTER_MAX_TOKENS=4096

# Local providers (no API key required)
# LM Studio: start the server, then:
# PYOPENAPI_LLM_PROVIDER=lmstudio
# PYOPENAPI_LLM_SPEC_MODEL=your-loaded-model-id
# PYOPENAPI_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# llama.cpp server:
# PYOPENAPI_LLM_PROVIDER=llamacpp
# PYOPENAPI_LLM_SPEC_MODEL=your-loaded-model-id
# PYOPENAPI_LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1

# Ollama:
# OLLAMA_HOST=127.0.0.1:11434
# PYOPENAPI_LLM_PROVIDER=ollama
# PYOPENAPI_LLM_SPEC_MODEL=llama3.1
# PYOPENAPI_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# ---- Legacy LLM settings (engine="llm", Django only) ----
# Models use the short user-facing names configured below.
# PYOPENAPI_SPEC_MODEL=gpt_4_1
# PYOPENAPI_CONTEXT_MODEL=gpt_4o_mini

# Azure OpenAI (multiple endpoints supported)
# AZURE_CONFIG_NAMES=main
# AZURE_ENDPOINT_MAIN=https://your-resource.openai.azure.com/
# AZURE_API_KEY_MAIN=...
# AZURE_API_VERSION_MAIN=2024-05-01-preview
# AZURE_DEFAULT_MODEL_NAME=gpt_4o_mini
# AZURE_MODEL_MAP_GPT_4_1=main/gpt-4.1
# AZURE_MODEL_MAP_GPT_4O_MINI=main/gpt-4o-mini

# Gemini (alternative provider)
# GOOGLE_API_KEY=...

# DeepSeek (alternative provider)
# DEEPSEEK_API_KEY=...


# Agent provider preference (nvidia Nemotron primary)
PYOPENAPI_AGENT_PREFERRED_PROVIDER=nvidia
PYOPENAPI_NVIDIA_SPEC_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
PYOPENAPI_NVIDIA_CONTEXT_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
